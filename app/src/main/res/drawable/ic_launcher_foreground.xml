<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — Opção A (spec: viewBox 0 0 100 100, scaled to 108×108)
  Safe area ~18% → conteúdo seguro entre 19–89dp
  Escudo verde sólido + checkmark preto recortado + brackets verdes nos cantos
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Corner brackets -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00FF66"
        android:strokeWidth="2.5"
        android:pathData="M10 18 L10 10 L18 10
                          M82 10 L90 10 L90 18
                          M10 82 L10 90 L18 90
                          M82 90 L90 90 L90 82"/>

    <!-- Shield — solid green fill -->
    <path
        android:fillColor="#00FF66"
        android:pathData="M50 8 L86 22 L86 54 Q86 80 50 96 Q14 80 14 54 L14 22 Z"/>

    <!-- Checkmark — black cutout over shield -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:pathData="M33 52 L46 64 L70 40"/>

</vector>
