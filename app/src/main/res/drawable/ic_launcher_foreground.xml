<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — Opção A
  Viewport 108×108dp.
  Escudo: ~45% do ícone (48×56dp centrado em 54,54) — deixa negro visível ao redor.
  Brackets: arm 12dp, stroke 3dp, nos cantos de 22..86 (zona squircle Samsung ✓).
  Contraste: brackets verdes sobre fundo preto fora do escudo verde.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Corner brackets — arm 12dp, fora do escudo sobre fundo preto -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00FF66"
        android:strokeWidth="3"
        android:pathData="M22,34 L22,22 L34,22
                          M74,22 L86,22 L86,34
                          M22,74 L22,86 L34,86
                          M74,86 L86,86 L86,74"/>

    <!-- Shield solid green — 48×56dp, x:30..78, y:26..82 -->
    <path
        android:fillColor="#00FF66"
        android:pathData="M54,26 L78,35 L78,55 Q78,71 54,82 Q30,71 30,55 L30,35 Z"/>

    <!-- Checkmark black — proporcional ao escudo menor -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="4.5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:pathData="M43,54 L51,62 L67,46"/>

</vector>
